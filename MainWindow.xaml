<Window
    x:Class="EveryPrinter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EveryPrinter">

    <Grid x:Name="Root" Background="{ThemeResource CanvasBrush}" AllowDrop="True" DragOver="RootDragOver" Drop="RootDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Top bar (also the window drag region) -->
        <Grid x:Name="TopBar" Grid.Row="0" Background="{ThemeResource ChromeBrush}" Padding="16,0,150,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="4" Background="{StaticResource AccentBrush}">
                    <FontIcon Glyph="&#xE749;" FontSize="12" Foreground="White" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Border>
                <TextBlock Text="Every Printer" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Width="1" Height="18" Background="{ThemeResource BorderBrush1}" Margin="6,0" />
                <TextBlock x:Name="DocumentTitle" Text="Nothing to print yet" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolButton}" Click="OpenClick" ToolTipService.ToolTip="Open files (Ctrl+O)">
                    <FontIcon Glyph="&#xE8E5;" FontSize="15" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="PasteClick" ToolTipService.ToolTip="Paste a picture or files from the clipboard (Ctrl+V)">
                    <FontIcon Glyph="&#xE77F;" FontSize="15" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Border Width="1" Height="18" Background="{ThemeResource BorderBrush1}" Margin="6,0" />
                <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Click="UndoClick" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon Glyph="&#xE7A7;" FontSize="15" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Click="RedoClick" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                    <FontIcon Glyph="&#xE7A6;" FontSize="15" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Border Width="1" Height="18" Background="{ThemeResource BorderBrush1}" Margin="6,0" />
                <Button Style="{StaticResource ToolButton}" Click="HistoryClick" ToolTipService.ToolTip="Print history">
                    <FontIcon Glyph="&#xE81C;" FontSize="15" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="ThemeToggleClick" ToolTipService.ToolTip="Light, dark or system theme (Ctrl+T)">
                    <FontIcon Glyph="&#xE793;" FontSize="15" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="HelpClick" ToolTipService.ToolTip="Keyboard shortcuts (F1)">
                    <FontIcon Glyph="&#xE897;" FontSize="15" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ImagesButton" Content="Save images…" Style="{StaticResource SecondaryButton}" Click="ImagesClick"
                        ToolTipService.ToolTip="Save every sheet as a picture (Ctrl+Shift+E)" />
                <Button x:Name="PdfButton" Content="Save as PDF…" Style="{StaticResource SecondaryButton}" Click="PdfClick"
                        ToolTipService.ToolTip="Save the sheets as one PDF (Ctrl+S)" />
                <Button x:Name="PrintButton" Style="{StaticResource PrimaryButton}" Click="PrintClick" ToolTipService.ToolTip="Print (Ctrl+P)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE749;" FontSize="13" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <TextBlock Text="Print" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="Progress" Grid.Row="1" IsIndeterminate="False" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed"
                     Foreground="{StaticResource AccentBrush}" Background="Transparent" Height="2" Padding="0" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="348" />
            </Grid.ColumnDefinitions>

            <!-- Sheet strip -->
            <Grid Grid.Column="0" Background="{ThemeResource RailBrush}" BorderBrush="{ThemeResource BorderBrush1}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SheetsHeader" Text="SHEETS" Style="{StaticResource PanelHeader}" Margin="14,12,14,8" />
                <ListView x:Name="SheetStrip" Grid.Row="1" SelectionMode="Single" ItemContainerStyle="{StaticResource BareListViewItem}"
                          SelectionChanged="SheetSelected" ContainerContentChanging="SheetContainerChanging" Padding="10,0,10,10"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SheetItem">
                            <Grid Margin="0,0,0,10" Padding="6" CornerRadius="6" Background="{ThemeResource TileBrush}"
                                  BorderBrush="{x:Bind Border, Mode=OneWay}" BorderThickness="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Height="{x:Bind ThumbHeight, Mode=OneWay}" Background="{ThemeResource CanvasBrush}" CornerRadius="2">
                                    <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="Uniform" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{x:Bind Caption}" Style="{StaticResource MutedText}" Margin="0,6,0,0" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Preview -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <Grid Background="{ThemeResource ChromeBrush}" BorderBrush="{ThemeResource BorderBrush1}" BorderThickness="0,0,0,1" Padding="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <ToggleButton x:Name="ToolSelect" Style="{StaticResource ToolToggle}" Click="ToolClick" Tag="Select" IsChecked="True" ToolTipService.ToolTip="Select and move (V). Drag to pan, click a page to select it">
                            <FontIcon Glyph="&#xE7C9;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolCrop" Style="{StaticResource ToolToggle}" Click="ToolClick" Tag="Crop" ToolTipService.ToolTip="Crop: drag over the part of a page to keep (C)">
                            <FontIcon Glyph="&#xE7A8;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolRedact" Style="{StaticResource ToolToggle}" Click="ToolClick" Tag="Redact" ToolTipService.ToolTip="Redact: drag to black out sensitive text. The page is printed as a picture so the text is really gone (X)">
                            <Rectangle Fill="{ThemeResource TextBrush}" Width="16" Height="9" RadiusX="1.5" RadiusY="1.5" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolHighlight" Style="{StaticResource ToolToggle}" Click="ToolClick" Tag="Highlight" ToolTipService.ToolTip="Highlight: drag over text (H)">
                            <FontIcon Glyph="&#xE7E6;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolText" Style="{StaticResource ToolToggle}" Click="ToolClick" Tag="Text" ToolTipService.ToolTip="Add text: click where it goes (T)">
                            <FontIcon Glyph="&#xE8D2;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolMeasure" Style="{StaticResource ToolToggle}" Click="ToolClick" Tag="Measure" ToolTipService.ToolTip="Measure in millimetres: drag a line (M)">
                            <Path Stroke="{ThemeResource TextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"
                                  Data="M2,14 L14,2 L18,6 L6,18 Z M6,10 L8,12 M9,7 L11,9 M12,4 L14,6" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToolLoupe" Style="{StaticResource ToolToggle}" Click="ToolClick" Tag="Loupe" ToolTipService.ToolTip="Loupe: magnify under the pointer (L)">
                            <Path Stroke="{ThemeResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform"
                                  Data="M8,2 A6,6 0 1 1 7.9,2 Z M12.5,12.5 L18,18 M5.5,8 L10.5,8" />
                        </ToggleButton>
                        <Border Width="1" Height="18" Background="{ThemeResource BorderBrush1}" Margin="6,0" />
                        <Button Style="{StaticResource ToolButton}" Width="34" Height="34" Click="RotateLeftClick" ToolTipService.ToolTip="Rotate the selected page left (Shift+R)">
                            <FontIcon Glyph="&#xE7AD;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Width="34" Height="34" Click="RotateRightClick" ToolTipService.ToolTip="Rotate the selected page right (R)">
                            <FontIcon Glyph="&#xE7AD;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Width="34" Height="34" Click="DeletePageClick" ToolTipService.ToolTip="Remove the selected page from the job (Delete)">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Width="34" Height="34" Click="ResetPageClick" ToolTipService.ToolTip="Undo every edit on the selected page">
                            <FontIcon Glyph="&#xE777;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                        <Border Width="1" Height="18" Background="{ThemeResource BorderBrush1}" Margin="6,0" />
                        <ToggleButton x:Name="FindToggle" Style="{StaticResource ToolToggle}" Click="FindToggleClick" ToolTipService.ToolTip="Find text in the pages (Ctrl+F)">
                            <FontIcon Glyph="&#xE721;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolButton}" Width="34" Height="34" Click="ZoomOutClick" ToolTipService.ToolTip="Zoom out (-)">
                            <FontIcon Glyph="&#xE71F;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                        <TextBlock x:Name="ZoomText" Text="100%" Width="46" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource ToolButton}" Width="34" Height="34" Click="ZoomInClick" ToolTipService.ToolTip="Zoom in (+)">
                            <FontIcon Glyph="&#xE8A3;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Width="34" Height="34" Click="FitClick" ToolTipService.ToolTip="Fit the sheet in the window (0)">
                            <FontIcon Glyph="&#xE9A6;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                        <ToggleButton x:Name="RulerToggle" Style="{StaticResource ToolToggle}" Click="RulerToggleClick" ToolTipService.ToolTip="Rulers">
                            <Path Stroke="{ThemeResource TextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"
                                  Data="M2,14 L14,2 L18,6 L6,18 Z M6,10 L8,12 M9,7 L11,9 M12,4 L14,6" />
                        </ToggleButton>
                        <ToggleButton x:Name="FullScreenToggle" Style="{StaticResource ToolToggle}" Click="FullScreenClick" ToolTipService.ToolTip="Full screen (F11)">
                            <FontIcon Glyph="&#xE740;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </ToggleButton>
                        <ToggleButton x:Name="TransparentToggle" Style="{StaticResource ToolToggle}" Click="TransparentClick" ToolTipService.ToolTip="Transparent window: see what is behind the preview (Ctrl+Shift+T)">
                            <FontIcon Glyph="&#xE7F7;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>

                <!-- Find bar -->
                <Grid x:Name="FindBar" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource PanelBrush}" Padding="12,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FindBox" PlaceholderText="Find text in the pages (read with OCR)" KeyDown="FindKeyDown" TextChanged="FindTextChanged" />
                    <Button Grid.Column="1" Style="{StaticResource TileButton}" Click="FindPreviousClick" Width="34" ToolTipService.ToolTip="Previous match (Shift+Enter)">
                        <FontIcon Glyph="&#xE70E;" FontSize="12" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource TileButton}" Click="FindNextClick" Width="34" ToolTipService.ToolTip="Next match (Enter)">
                        <FontIcon Glyph="&#xE70D;" FontSize="12" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </Button>
                    <TextBlock x:Name="FindStatus" Grid.Column="3" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </Grid>

                <Grid x:Name="PreviewHost" Grid.Row="2" Background="{ThemeResource CanvasBrush}"
                      SizeChanged="PreviewSizeChanged" PointerPressed="PreviewPointerPressed" PointerMoved="PreviewPointerMoved"
                      PointerReleased="PreviewPointerReleased" PointerCaptureLost="PreviewPointerCaptureLost" PointerWheelChanged="PreviewWheel"
                      PointerExited="PreviewPointerExited">
                    <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Image.RenderTransform>
                            <CompositeTransform x:Name="PreviewMove" />
                        </Image.RenderTransform>
                    </Image>
                    <Canvas x:Name="Overlay" IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionBox" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed" />
                        <Rectangle x:Name="RubberBand" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" StrokeDashArray="4 3"
                                   Fill="#332680EB" Visibility="Collapsed" />
                        <Line x:Name="MeasureLine" Stroke="#FFEB3B" StrokeThickness="2" Visibility="Collapsed" />
                        <Border x:Name="MeasureLabel" Background="#E6212121" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                            <TextBlock x:Name="MeasureText" Foreground="White" FontSize="12" />
                        </Border>
                        <Border x:Name="LoupeFrame" Width="190" Height="190" CornerRadius="95" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3"
                                Background="White" Visibility="Collapsed">
                            <Image x:Name="LoupeImage" Stretch="Fill" />
                        </Border>
                    </Canvas>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="440" IsHitTestVisible="False">
                        <FontIcon Glyph="&#xE749;" FontSize="52" Foreground="{ThemeResource TextMutedBrush}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <TextBlock Text="Drop files here" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource MutedText}" FontSize="12"
                                   Text="PDFs, pictures and text files. Arrange them on sheets, mark them up, then print, save as PDF or save as images. Press Ctrl+O to choose files, or Ctrl+V to paste a picture." />
                    </StackPanel>
                    <Border x:Name="BusyVeil" Background="#66000000" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <ProgressRing IsActive="True" Width="32" Height="32" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="BusyText" Foreground="White" HorizontalAlignment="Center" />
                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Foreground="White" BorderBrush="White" HorizontalAlignment="Center" Click="BusyCancelClick" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Sheet navigation -->
                <Grid Grid.Row="3" Background="{ThemeResource ChromeBrush}" BorderBrush="{ThemeResource BorderBrush1}" BorderThickness="0,1,0,0" Padding="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolButton}" Width="32" Height="32" Click="FirstSheetClick" ToolTipService.ToolTip="First sheet (Home)">
                            <FontIcon Glyph="&#xE892;" FontSize="12" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Width="32" Height="32" Click="PreviousSheetClick" ToolTipService.ToolTip="Previous sheet (Left or Page Up)">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                        <TextBlock x:Name="SheetPosition" Text="—" MinWidth="130" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource ToolButton}" Width="32" Height="32" Click="NextSheetClick" ToolTipService.ToolTip="Next sheet (Right or Page Down)">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Width="32" Height="32" Click="LastSheetClick" ToolTipService.ToolTip="Last sheet (End)">
                            <FontIcon Glyph="&#xE893;" FontSize="12" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Inspector -->
            <Grid Grid.Column="2" Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource BorderBrush1}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Themes -->
                <Grid Padding="14,12,14,4" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" SelectionChanged="ThemeSelected" ToolTipService.ToolTip="Theme: a saved set of every setting below" />
                    <Button Grid.Column="1" Style="{StaticResource TileButton}" Width="34" Click="ThemeSaveClick" ToolTipService.ToolTip="Save the current settings as a theme">
                        <FontIcon Glyph="&#xE74E;" FontSize="13" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource TileButton}" Width="34" ToolTipService.ToolTip="More theme actions">
                        <FontIcon Glyph="&#xE712;" FontSize="13" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Save as new theme…" Click="ThemeSaveAsClick" />
                                <MenuFlyoutItem Text="Delete this theme" Click="ThemeDeleteClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Import theme…" Click="ThemeImportClick" />
                                <MenuFlyoutItem Text="Export theme…" Click="ThemeExportClick" />
                                <MenuFlyoutItem Text="Open themes folder" Click="ThemeFolderClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- Tabs -->
                <StackPanel x:Name="TabStrip" Grid.Row="1" Orientation="Horizontal" Spacing="2" Padding="10,6,10,8" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="InspectorHost" Padding="14,4,14,24" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="3" Background="{ThemeResource ChromeBrush}" BorderBrush="{ThemeResource BorderBrush1}" BorderThickness="0,1,0,0" Padding="14,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="InkText" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <!-- Toast -->
        <Border x:Name="Toast" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,60"
                Background="{ThemeResource TileBrush}" BorderBrush="{ThemeResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="14,10" MaxWidth="620">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="ToastText" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="ToastAction" Style="{StaticResource GhostButton}" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" Click="ToastActionClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
